{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subsidies-api.schema.json",
  "title": "Subsidy API Record",
  "type": "array",
  "items": {
    "$ref": "#/$defs/record"
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "id",
        "name",
        "scope",
        "provider",
        "classification",
        "eligibility",
        "benefit",
        "application",
        "search",
        "extensions",
        "source_meta"
      ],
      "properties": {
        "api_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "required": [
            "level",
            "regions"
          ],
          "properties": {
            "level": {
              "enum": [
                "central",
                "taipei",
                "private_national",
                "mixed"
              ]
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "provider": {
          "type": "object",
          "required": [
            "name",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "government",
                "school",
                "foundation",
                "private",
                "mixed",
                "unknown"
              ]
            }
          }
        },
        "classification": {
          "type": "object",
          "required": [
            "category",
            "benefit_type"
          ],
          "properties": {
            "category": {
              "type": "string"
            },
            "benefit_type": {
              "type": "string"
            }
          }
        },
        "eligibility": {
          "type": "object",
          "required": [
            "age",
            "income",
            "residence",
            "student",
            "employment",
            "disability",
            "household",
            "property",
            "nationality",
            "exclusions",
            "raw_summary",
            "taipei_applicability"
          ],
          "properties": {
            "age": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/age"
              }
            },
            "income": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/income"
              }
            },
            "residence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/residence"
              }
            },
            "student": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/student"
              }
            },
            "employment": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/employment"
              }
            },
            "disability": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/disability"
              }
            },
            "household": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/household"
              }
            },
            "property": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/property"
              }
            },
            "nationality": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nationality"
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "raw_summary": {
              "type": "string"
            },
            "taipei_applicability": {
              "type": "string"
            }
          }
        },
        "benefit": {
          "type": "object",
          "required": [
            "kind",
            "amounts",
            "raw"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "amounts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/amount"
              }
            },
            "raw": {
              "type": "string"
            }
          }
        },
        "application": {
          "type": "object",
          "required": [
            "methods",
            "agency",
            "channel_text",
            "process_text",
            "required_documents",
            "deadline",
            "urls"
          ],
          "properties": {
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "agency": {
              "type": "string"
            },
            "channel_text": {
              "type": "string"
            },
            "process_text": {
              "type": "string"
            },
            "required_documents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/document"
              }
            },
            "deadline": {
              "$ref": "#/$defs/deadline"
            },
            "urls": {
              "type": "object",
              "required": [
                "program",
                "apply",
                "form"
              ],
              "properties": {
                "program": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "apply": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "form": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "form_fields": {
              "type": "object",
              "description": "Analysis of the application form PDF for this record. The main form is described at the top level, further PDFs under attachments. Field positions are heuristic.",
              "required": [
                "status",
                "fields"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "source_url": {
                  "type": "string",
                  "description": "URL the file was downloaded from (may differ from application.urls.form, which is left untouched)"
                },
                "found_on": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Page on which the link was found"
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "recorded",
                    "discovered"
                  ],
                  "description": "recorded = application.urls.form; discovered = found on the program/source pages"
                },
                "content_type": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "analyzed",
                    "no_fillable_form",
                    "scanned_image_pdf",
                    "text_unreadable",
                    "analysis_error",
                    "office_file_only",
                    "online_system",
                    "no_form_exists",
                    "download_failed"
                  ]
                },
                "is_application_form": {
                  "type": [
                    "boolean",
                    "string"
                  ],
                  "description": "Present only when not confidently an applicant form (e.g. 'unsure')"
                },
                "local_file": {
                  "type": "string",
                  "description": "PDF path relative to the data directory"
                },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "page",
                      "width",
                      "height"
                    ],
                    "properties": {
                      "page": {
                        "type": "integer"
                      },
                      "width": {
                        "type": "number"
                      },
                      "height": {
                        "type": "number"
                      }
                    }
                  }
                },
                "form_pages": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "Pages that contain fillable fields; fields on other pages are never reported"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "label",
                      "key",
                      "prefill",
                      "box"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "text",
                          "date",
                          "checkbox",
                          "signature"
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "key": {
                        "type": "string"
                      },
                      "prefill": {
                        "type": "boolean",
                        "description": "true when the value can be filled from the user's profile"
                      },
                      "prefill_key": {
                        "type": "string",
                        "enum": [
                          "name",
                          "national_id",
                          "gender",
                          "phone",
                          "mobile",
                          "address"
                        ]
                      },
                      "variant": {
                        "type": "string"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "box": {
                        "type": "object",
                        "required": [
                          "page",
                          "x",
                          "y",
                          "w",
                          "h"
                        ],
                        "properties": {
                          "page": {
                            "type": "integer"
                          },
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "w": {
                            "type": "number"
                          },
                          "h": {
                            "type": "number"
                          }
                        }
                      },
                      "candidate_key": {
                        "type": "string",
                        "enum": [
                          "name",
                          "national_id",
                          "gender",
                          "phone",
                          "mobile",
                          "address"
                        ],
                        "description": "Kind of personal data this box asks for, when it is NOT pre-filled (blocked_reason says why). The app may ask the user to confirm instead."
                      },
                      "blocked_reason": {
                        "type": "string",
                        "enum": [
                          "other_person",
                          "subject_unclear",
                          "label_unclear",
                          "not_personal_id",
                          "not_personal_address",
                          "not_personal_phone",
                          "organization",
                          "handwritten_signature",
                          "handwritten_signature_required",
                          "signature_or_seal"
                        ],
                        "description": "Why the box is not pre-filled. other_person = belongs to someone other than the applicant (agent, payee, family member, contact person ...); subject_unclear = cannot confirm it is the applicant; handwritten_signature / signature_or_seal = signature lines are never auto-filled; handwritten_signature_required = printed-name box in a signature block of a form that demands 親簽."
                      },
                      "subject": {
                        "type": "string",
                        "enum": [
                          "applicant",
                          "other",
                          "unknown"
                        ],
                        "description": "Whom the box is about. Only `applicant` with explicit evidence is pre-filled."
                      },
                      "subject_evidence": {
                        "type": "string",
                        "description": "How the subject was established: label | row_header:<text> | column_header:<text> | section_heading:<text> | same_block_as_name:<label> | sole_person_on_page | conflict:<text>"
                      },
                      "signature_mode": {
                        "type": "string",
                        "enum": [
                          "handwritten_required",
                          "signature_or_seal"
                        ],
                        "description": "Signature fields only; never pre-filled either way."
                      },
                      "preprinted_prefix": {
                        "type": "string",
                        "description": "Address already pre-printed on the form (e.g. 臺北市); fill the remainder only."
                      }
                    }
                  }
                },
                "coordinate_system": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "description": "Why no PDF is available (for non-analyzed statuses)"
                },
                "office_files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "ODT/DOCX/XLS candidates found but not analyzed"
                },
                "attachments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "status",
                      "fields"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "source_url": {
                        "type": "string",
                        "description": "URL the file was downloaded from (may differ from application.urls.form, which is left untouched)"
                      },
                      "found_on": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Page on which the link was found"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "recorded",
                          "discovered"
                        ],
                        "description": "recorded = application.urls.form; discovered = found on the program/source pages"
                      },
                      "content_type": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "analyzed",
                          "no_fillable_form",
                          "scanned_image_pdf",
                          "text_unreadable",
                          "analysis_error",
                          "office_file_only",
                          "online_system",
                          "no_form_exists",
                          "download_failed"
                        ]
                      },
                      "is_application_form": {
                        "type": [
                          "boolean",
                          "string"
                        ],
                        "description": "Present only when not confidently an applicant form (e.g. 'unsure')"
                      },
                      "local_file": {
                        "type": "string",
                        "description": "PDF path relative to the data directory"
                      },
                      "pages": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "page",
                            "width",
                            "height"
                          ],
                          "properties": {
                            "page": {
                              "type": "integer"
                            },
                            "width": {
                              "type": "number"
                            },
                            "height": {
                              "type": "number"
                            }
                          }
                        }
                      },
                      "form_pages": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        },
                        "description": "Pages that contain fillable fields; fields on other pages are never reported"
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "type",
                            "label",
                            "key",
                            "prefill",
                            "box"
                          ],
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "text",
                                "date",
                                "checkbox",
                                "signature"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "key": {
                              "type": "string"
                            },
                            "prefill": {
                              "type": "boolean",
                              "description": "true when the value can be filled from the user's profile"
                            },
                            "prefill_key": {
                              "type": "string",
                              "enum": [
                                "name",
                                "national_id",
                                "gender",
                                "phone",
                                "mobile",
                                "address"
                              ]
                            },
                            "variant": {
                              "type": "string"
                            },
                            "options": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "box": {
                              "type": "object",
                              "required": [
                                "page",
                                "x",
                                "y",
                                "w",
                                "h"
                              ],
                              "properties": {
                                "page": {
                                  "type": "integer"
                                },
                                "x": {
                                  "type": "number"
                                },
                                "y": {
                                  "type": "number"
                                },
                                "w": {
                                  "type": "number"
                                },
                                "h": {
                                  "type": "number"
                                }
                              }
                            },
                            "candidate_key": {
                              "type": "string",
                              "enum": [
                                "name",
                                "national_id",
                                "gender",
                                "phone",
                                "mobile",
                                "address"
                              ],
                              "description": "Kind of personal data this box asks for, when it is NOT pre-filled (blocked_reason says why). The app may ask the user to confirm instead."
                            },
                            "blocked_reason": {
                              "type": "string",
                              "enum": [
                                "other_person",
                                "subject_unclear",
                                "label_unclear",
                                "not_personal_id",
                                "not_personal_address",
                                "not_personal_phone",
                                "organization",
                                "handwritten_signature",
                                "handwritten_signature_required",
                                "signature_or_seal"
                              ],
                              "description": "Why the box is not pre-filled. other_person = belongs to someone other than the applicant (agent, payee, family member, contact person ...); subject_unclear = cannot confirm it is the applicant; handwritten_signature / signature_or_seal = signature lines are never auto-filled; handwritten_signature_required = printed-name box in a signature block of a form that demands 親簽."
                            },
                            "subject": {
                              "type": "string",
                              "enum": [
                                "applicant",
                                "other",
                                "unknown"
                              ],
                              "description": "Whom the box is about. Only `applicant` with explicit evidence is pre-filled."
                            },
                            "subject_evidence": {
                              "type": "string",
                              "description": "How the subject was established: label | row_header:<text> | column_header:<text> | section_heading:<text> | same_block_as_name:<label> | sole_person_on_page | conflict:<text>"
                            },
                            "signature_mode": {
                              "type": "string",
                              "enum": [
                                "handwritten_required",
                                "signature_or_seal"
                              ],
                              "description": "Signature fields only; never pre-filled either way."
                            },
                            "preprinted_prefix": {
                              "type": "string",
                              "description": "Address already pre-printed on the form (e.g. 臺北市); fill the remainder only."
                            }
                          }
                        }
                      },
                      "signature_policy": {
                        "type": "object",
                        "required": [
                          "requires_handwritten",
                          "evidence"
                        ],
                        "description": "Whether the PDF demands a hand-written signature (親簽 / 親筆 / 不得代簽 ...). Signature fields are never auto-filled regardless.",
                        "properties": {
                          "requires_handwritten": {
                            "type": "boolean"
                          },
                          "evidence": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "page": {
                                  "type": "integer"
                                },
                                "text": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "description": "Other PDFs for the same record (consent, affidavit, receipt ...)"
                },
                "signature_policy": {
                  "type": "object",
                  "required": [
                    "requires_handwritten",
                    "evidence"
                  ],
                  "description": "Whether the PDF demands a hand-written signature (親簽 / 親筆 / 不得代簽 ...). Signature fields are never auto-filled regardless.",
                  "properties": {
                    "requires_handwritten": {
                      "type": "boolean"
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "page": {
                            "type": "integer"
                          },
                          "text": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "search": {
          "type": "object",
          "required": [
            "keywords",
            "facets",
            "text"
          ],
          "properties": {
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "facets": {
              "type": "object",
              "required": [
                "scope",
                "regions",
                "category",
                "benefit_type",
                "applicant_types"
              ],
              "properties": {
                "scope": {
                  "type": "string"
                },
                "regions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "category": {
                  "type": "string"
                },
                "benefit_type": {
                  "type": "string"
                },
                "applicant_types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "text": {
              "type": "string"
            }
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          }
        },
        "source_meta": {
          "type": "object",
          "required": [
            "verification_status",
            "verification_note",
            "application_status",
            "checked_date",
            "relation_to_original",
            "missing_fields",
            "notes",
            "sources"
          ],
          "properties": {
            "verification_status": {
              "enum": [
                "verified",
                "partial",
                "unverified"
              ]
            },
            "verification_note": {
              "type": "string"
            },
            "application_status": {
              "type": "string"
            },
            "checked_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "relation_to_original": {
              "type": "string"
            },
            "missing_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "merge": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "legacy_ids": {
              "type": "object"
            },
            "related_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "has_supplemental": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "age": {
      "type": "object",
      "required": [
        "subject",
        "min",
        "max",
        "unit",
        "raw"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "year",
            "month",
            "day"
          ]
        },
        "raw": {
          "type": "string"
        }
      }
    },
    "income": {
      "type": "object",
      "required": [
        "subject",
        "metric",
        "operator",
        "value",
        "currency",
        "period",
        "multiplier_base",
        "multiplier_value",
        "year",
        "raw"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "metric": {
          "enum": [
            "annual_income",
            "monthly_income",
            "per_capita_income",
            "interest_income",
            "income_multiple",
            "other"
          ]
        },
        "operator": {
          "enum": [
            "<",
            "<=",
            "==",
            ">=",
            ">",
            "in",
            "text"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplier_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "multiplier_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "raw": {
          "type": "string"
        }
      }
    },
    "residence": {
      "type": "object",
      "required": [
        "region",
        "registered_required",
        "actual_residence_required",
        "min_duration_months",
        "raw"
      ],
      "properties": {
        "region": {
          "type": "string"
        },
